# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (for AI pitch generation)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Worker (Railway)
# Uses the same Supabase service role key

# LuxWeb CRM lead push (studio-internal — leave unset and the feature hides)
# Sends found businesses straight onto a setter's call list in the CRM.
LUXWEB_CRM_URL=https://portal.luxwebstudio.dev
LUXWEB_CRM_INGEST_KEY=shared-secret-matching-OUTREACH_INGEST_KEY
# Non-admin accounts allowed to push (comma-separated). Admins always can.
CRM_PUSH_EMAILS=setter@example.com
